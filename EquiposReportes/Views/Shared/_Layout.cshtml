<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Reportes</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
<nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
    <div class="container">
        <span class="navbar-brand">Reportes de Equipos</span>
        @if (Context.Session.GetString("Rol") == "Admin")
        {
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" asp-controller="Reportes" asp-action="Inventario">Inventario</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Reportes" asp-action="Vencidos">Vencidos</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Reportes" asp-action="Top">Top 5</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Reportes" asp-action="Historial">Historial</a></li>
            </ul>
            <span class="navbar-text me-3">@Context.Session.GetString("Username") (Admin)</span>
            <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm">Cerrar sesión</button></form>
        }
    </div>
</nav>
<div class="container">@RenderBody()</div>
</body>
</html>
