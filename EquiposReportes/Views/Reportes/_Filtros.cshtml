@model EquiposReportes.Models.FiltroReporte
@{
    var categorias = (List<EquiposReportes.Models.CategoriaOpcion>)ViewData["Categorias"]!;
    bool conFechas = (bool)ViewData["ConFechas"]!;
    bool conCategoria = (bool)ViewData["ConCategoria"]!;
    bool conUsuario = (bool)ViewData["ConUsuario"]!;
}
<form method="get" class="row g-2 mb-3">
    @if (conUsuario)
    {
        <div class="col-md-3"><input name="Username" value="@Model.Username" class="form-control" placeholder="Username" /></div>
    }
    @if (conFechas)
    {
        <div class="col-md-2"><input type="date" name="Desde" value="@Model.Desde?.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div class="col-md-2"><input type="date" name="Hasta" value="@Model.Hasta?.ToString("yyyy-MM-dd")" class="form-control" /></div>
    }
    @if (conCategoria)
    {
        <div class="col-md-3">
            <select name="CategoriaId" class="form-select">
                <option value="">Todas las categorías</option>
                @foreach (var c in categorias)
                {
                    <option value="@c.Id" selected="@(Model.CategoriaId == c.Id)">@c.Nombre</option>
                }
            </select>
        </div>
    }
    <div class="col-md-2"><button class="btn btn-secondary">Filtrar</button></div>
</form>
