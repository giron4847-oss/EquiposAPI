@model EquiposReportes.Models.LoginViewModel
@{ ViewData["Title"] = "Login"; }
<h2>Iniciar sesión</h2>
<p class="text-muted">Solo el rol Admin puede ver los reportes.</p>
<form asp-action="Login" method="post" style="max-width:400px">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Username" class="form-label"></label><input asp-for="Username" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" type="password" class="form-control" /></div>
    <button class="btn btn-primary">Entrar</button>
</form>
