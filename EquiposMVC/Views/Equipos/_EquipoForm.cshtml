@model EquiposMVC.Models.EquipoFormViewModel
<div asp-validation-summary="All" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="CodigoInventario" class="form-label"></label>
    <input asp-for="CodigoInventario" class="form-control" />
    <span asp-validation-for="CodigoInventario" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Nombre" class="form-label"></label>
    <input asp-for="Nombre" class="form-control" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Descripcion" class="form-label"></label>
    <textarea asp-for="Descripcion" class="form-control"></textarea>
</div>
<div class="mb-3">
    <label asp-for="CategoriaId" class="form-label">Categoría</label>
    <select asp-for="CategoriaId" asp-items="Model.Categorias" class="form-select">
        <option value="0">-- Selecciona --</option>
    </select>
    <span asp-validation-for="CategoriaId" class="text-danger"></span>
</div>
